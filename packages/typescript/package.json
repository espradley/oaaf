{
  "name": "@oaaf/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Open Agent Authority Framework (OAAF).",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/mint.d.ts",
      "default": "./dist/testing/mint.js"
    },
    "./mcp": {
      "types": "./dist/mcp/coaz.d.ts",
      "default": "./dist/mcp/coaz.js"
    },
    "./a2a": {
      "types": "./dist/a2a/binding.d.ts",
      "default": "./dist/a2a/binding.js"
    },
    "./authzen": {
      "types": "./dist/authzen/map.d.ts",
      "default": "./dist/authzen/map.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/espradley/oaaf.git",
    "directory": "packages/typescript"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build"
  },
  "dependencies": {
    "canonicalize": "^4.0.0",
    "jose": "^6.2.9"
  },
  "keywords": [
    "oaaf",
    "authorization",
    "delegation",
    "agent",
    "mcp",
    "a2a",
    "authzen",
    "aat",
    "ai-agents"
  ],
  "homepage": "https://github.com/espradley/oaaf/tree/main/packages/typescript",
  "bugs": {
    "url": "https://github.com/espradley/oaaf/issues"
  },
  "author": "Edwin Digital LLC"
}
