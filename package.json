{
  "name": "oaaf",
  "version": "0.0.0",
  "private": true,
  "description": "Open Agent Authority Framework \u2014 an open protocol for proving what an AI agent is allowed to do.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build --force && tsc -p packages/typescript/tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:boundary": "node scripts/check-dependency-boundary.mjs",
    "check": "npm run check:boundary && npm run check:telemetry && npm run check:conformance && npm run check:manifest && npm run check:governance && npm run format:check && npm run typecheck && npm run test",
    "clean": "tsc --build --clean",
    "demo": "npm run build && node examples/quickstart/index.js",
    "demo:mcp": "npm run build && node examples/mcp-tool-guard/index.js",
    "demo:mcp-filesystem": "npm run build && node examples/mcp-filesystem-guard/index.js",
    "demo:a2a": "npm run build && node examples/a2a-delegation/index.js",
    "demo:cross": "npm run build && node examples/cross-transport/index.js",
    "inspect": "npm run build && node examples/inspector/inspect.js",
    "check:governance": "node scripts/check-governance.mjs",
    "check:package": "node scripts/check-downstream.mjs",
    "demo:pdp": "npm run build && node examples/pdp-coexistence/index.js",
    "check:telemetry": "node scripts/check-no-telemetry.mjs",
    "check:conformance": "node scripts/check-conformance-spec.mjs",
    "gen:corpus": "npm run build && node scripts/gen-conformance-corpus.mjs",
    "conform": "npm run build && node scripts/oaaf-conform.mjs --adapter \"node adapters/typescript/adapter.mjs\"",
    "conform:json": "npm run build && node scripts/oaaf-conform.mjs --adapter \"node adapters/typescript/adapter.mjs\" --json",
    "gen:manifest": "node scripts/gen-manifest.mjs",
    "check:manifest": "node scripts/check-manifest.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
