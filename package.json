{
  "name": "oaaf",
  "version": "0.0.0",
  "private": true,
  "description": "Open Agent Authority Framework — an open protocol for proving what an AI agent is allowed to do.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build --force && tsc -p packages/typescript/tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:boundary": "node scripts/check-dependency-boundary.mjs",
    "check": "npm run check:boundary && npm run format:check && npm run typecheck && npm run test",
    "clean": "tsc --build --clean"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
